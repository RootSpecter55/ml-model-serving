# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5444/ml

# --- Keys (bearer tokens) ---
# Admin: training and the model registry. API key: predictions.
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters-long
API_KEY=change-me-client-key-at-least-32-characters-long

# --- MLflow ---
# docker compose sets http://mlflow:5000 for the API container. Running outside Docker,
# use http://localhost:5001 (the compose MLflow server) or a local SQLite store as below.
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT=model-serving
# Only for a local store: where artifacts go when the experiment is created. Leave empty
# with a tracking server, which stores artifacts itself.
MLFLOW_ARTIFACT_LOCATION=
MLFLOW_DISABLE_AGENT_HINT=1

# --- Serving ---
DEFAULT_MODEL_NAME=breast-cancer
MAX_BATCH_SIZE=100
